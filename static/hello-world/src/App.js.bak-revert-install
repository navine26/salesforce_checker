import React, { useEffect, useState, useCallback } from 'react';
import { events, invoke } from '@forge/bridge';
import Spinner from '@atlaskit/spinner';

const InfoRow = ({ label, value }) => (
  <div style={{
    display: 'flex',
    justifyContent: 'space-between',
    padding: '10px 0',
    borderBottom: '1px solid #f0f0f0',
    fontSize: '13px'
  }}>
    <span style={{ color: '#6B778C', fontWeight: '500' }}>{label}</span>
    <span style={{ color: '#172B4D', fontWeight: '400', textAlign: 'right', maxWidth: '60%', wordBreak: 'break-word' }}>
      {value === null || value === undefined || value === '' ? '—' : String(value)}
    </span>
  </div>
);

const SectionTitle = ({ children }) => (
  <h4 style={{
    color: '#6B778C',
    margin: '18px 0 10px',
    fontSize: '13px',
    borderBottom: '1px solid #ccc',
    paddingBottom: '6px'
  }}>
    {children}
  </h4>
);

const CASE_FIELD_PRIORITY = [
  'Case Number', 'Case_ID__c', 'caseNumber', 'Subject', 'subject', 'Status', 'status',
  'Priority', 'Origin', 'Description', 'CreatedDate', 'ClosedDate', 'LastModifiedDate',
  'OwnerId', 'ContactId', 'AccountId', 'Salesforce Case Id', 'Id'
];

const SKIP_DETAIL_KEYS = new Set([
  'cases', 'attributes', 'found', 'matched', 'matchSource', 'warning', 'installation', 'delivery',
  'requestedCaseNumber',
  // Never show account fields in the case popup
  'Salesforce Account Id', 'Salutation', 'Account Name', 'Account Email', 'Account Number',
  'Jira Issue Key', 'RecordTypeId', 'PersonMailingStreet', 'PersonMailingPostalCode',
  'PersonContactId', 'PersonMobilePhone', 'PersonBirthdate', 'Signup_Type__c',
  'Cust_Account_Type__c', 'Nationality__c', 'Race__c', 'Citizenship__c', 'Account_ID__c',
  'Username__c', 'Entity__c', 'Referral_Code__c', 'Zuora_Account_ID__c', 'Account_Status__pc',
  'Sign_up_Date__c', 'Account_Active_Duration_Months__c', 'Type'
]);

function entriesFromObject(obj, priority = []) {
  if (!obj || typeof obj !== 'object') return [];
  const entries = [];
  const used = new Set();
  priority.forEach((key) => {
    if (Object.prototype.hasOwnProperty.call(obj, key) && !SKIP_DETAIL_KEYS.has(key)) {
      const val = obj[key];
      if (val !== null && typeof val !== 'object') {
        entries.push([key, val]);
        used.add(key);
      }
    }
  });
  Object.keys(obj).forEach((key) => {
    if (used.has(key) || SKIP_DETAIL_KEYS.has(key)) return;
    const val = obj[key];
    if (val !== null && typeof val !== 'object') {
      entries.push([key, val]);
    }
  });
  return entries;
}

function App() {
  const [sfData, setSfData] = useState(null);
  const [loading, setLoading] = useState(false);
  const [searchTerm, setSearchTerm] = useState('');
  const [activeTab, setActiveTab] = useState('TAB 1');
  const [isLinking, setIsLinking] = useState(false);

  const [caseModalOpen, setCaseModalOpen] = useState(false);
  const [selectedCaseNumber, setSelectedCaseNumber] = useState('');
  const [caseDetailRows, setCaseDetailRows] = useState([]);
  const [installationRows, setInstallationRows] = useState([]);
  const [deliveryRows, setDeliveryRows] = useState([]);
  const [caseLoading, setCaseLoading] = useState(false);
  const [caseWarning, setCaseWarning] = useState('');

  const fetchData = useCallback((query = '') => {
    if (!query) {
      setSfData(null);
      return;
    }
    setLoading(true);
    invoke('getSalesforceData', { search: query })
      .then((res) => {
        setSfData(res?.data || null);
        setLoading(false);
      })
      .catch((err) => {
        console.error('Fetch error:', err);
        setLoading(false);
      });
  }, []);

  const openCaseDetail = async (caseItem) => {
    const caseNumber = caseItem?.caseNumber || '';
    if (!caseNumber) return;

    setSelectedCaseNumber(caseNumber);
    setCaseModalOpen(true);
    setCaseLoading(true);
    setCaseWarning('');
    // Optimistic: show the clicked row immediately so the popup never flashes the wrong case
    setCaseDetailRows([
      ['Case Number', caseNumber],
      ['Subject', caseItem.subject],
      ['Status', caseItem.status]
    ]);
    setInstallationRows([]);
    setDeliveryRows([]);

    try {
      const res = await invoke('getCaseDetail', {
        caseNumber,
        accountNumber: searchTerm || sfData?.['Account Number'] || '',
        listCaseItem: {
          caseNumber: caseItem.caseNumber,
          subject: caseItem.subject,
          status: caseItem.status
        }
      });

      if (res?.error) {
        setCaseWarning(res.error);
        return;
      }

      setCaseWarning(res?.warning || '');
      setCaseDetailRows(entriesFromObject(res?.data, CASE_FIELD_PRIORITY));
      setInstallationRows(entriesFromObject(res?.installation));
      setDeliveryRows(entriesFromObject(res?.delivery));
    } catch (err) {
      console.error('Case detail error:', err);
      setCaseWarning('Failed to load case detail.');
    } finally {
      setCaseLoading(false);
    }
  };

  const closeCaseModal = () => {
    setCaseModalOpen(false);
    setSelectedCaseNumber('');
    setCaseDetailRows([]);
    setInstallationRows([]);
    setDeliveryRows([]);
    setCaseWarning('');
    setCaseLoading(false);
  };

  const handleLink = async () => {
    if (!searchTerm) return;
    setIsLinking(true);
    try {
      const res = await invoke('linkAccountToIssue', { accountNumber: searchTerm });
      if (res.success) {
        alert(`Account ${searchTerm} linked to this ticket.`);
      }
    } catch (err) {
      console.error('Link error:', err);
    } finally {
      setIsLinking(false);
    }
  };

  useEffect(() => {
    const loadAppData = async () => {
      const savedAccount = await invoke('getIssueField');
      if (savedAccount) {
        setSearchTerm(savedAccount);
        fetchData(savedAccount);
      } else {
        setSearchTerm('');
        setSfData(null);
      }
    };

    loadAppData();

    const sub = events.on('JIRA_ISSUE_CHANGED', () => {
      loadAppData();
    });

    return () => sub.then(s => s.unsubscribe());
  }, []);

  const getTabStyle = (tabName) => ({
    padding: '8px 25px',
    margin: '10px 5px 0 5px',
    cursor: 'pointer',
    fontSize: '12px',
    fontWeight: 'bold',
    color: activeTab === tabName ? '#000' : '#6B778C',
    backgroundColor: activeTab === tabName ? '#fff' : '#f0f0f0',
    border: '1px solid #4a90e2',
    borderBottom: activeTab === tabName ? 'none' : '1px solid #4a90e2',
    borderRadius: '8px 8px 0 0',
    zIndex: activeTab === tabName ? 2 : 1,
    position: 'relative',
    bottom: activeTab === tabName ? '-1px' : '0px'
  });

  return (
    <div style={{
      backgroundColor: '#fff',
      minHeight: '500px',
      border: '2px solid #4a90e2',
      borderRadius: '4px',
      overflow: 'hidden',
      fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif',
      position: 'relative'
    }}>
      <div style={{
        background: 'linear-gradient(to right, #4a90e2, #7ebffc)',
        color: 'white',
        padding: '15px 20px',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'space-between'
      }}>
        <div style={{ display: 'flex', alignItems: 'center' }}>
          <div style={{
            background: 'white', borderRadius: '4px', width: '42px', height: '42px',
            marginRight: '15px', display: 'flex', justifyContent: 'center',
            alignItems: 'center', fontSize: '22px'
          }}>🏢</div>
          <div>
            <div style={{ fontSize: '14px', fontWeight: 'bold', textTransform: 'uppercase' }}>
              {sfData?.['Account Name'] || 'COMPANY NAME'}
            </div>
            <div style={{ fontSize: '11px', opacity: 0.9 }}>
              {sfData?.['Account Number'] || 'ACCOUNT NUMBER/NRIC/FIN'} | {sfData?.['Type'] || 'TYPE OF CUSTOMER CORP/RESI'}
            </div>
          </div>
        </div>

        <div style={{ display: 'flex', gap: '10px' }}>
          <div style={{ position: 'relative' }}>
            <input
              style={{
                border: 'none', padding: '8px 35px 8px 12px', borderRadius: '4px',
                width: '240px', fontSize: '12px', color: '#333', outline: 'none'
              }}
              placeholder="Search Account..."
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              onKeyDown={(e) => e.key === 'Enter' && fetchData(searchTerm)}
            />
            <span style={{
              position: 'absolute', right: '10px', top: '6px',
              color: '#4a90e2', cursor: 'pointer', fontSize: '18px'
            }} onClick={() => fetchData(searchTerm)}>🔍</span>
          </div>
          <button
            onClick={() => fetchData(searchTerm)}
            style={{ background: 'white', color: '#4a90e2', border: 'none', padding: '8px 16px', borderRadius: '4px', cursor: 'pointer', fontWeight: 'bold', fontSize: '12px' }}
          >Refresh</button>
          <button
            onClick={handleLink}
            disabled={isLinking || !sfData}
            style={{ background: '#0052CC', color: 'white', border: 'none', padding: '8px 16px', borderRadius: '4px', cursor: 'pointer', fontWeight: 'bold', fontSize: '12px', opacity: (isLinking || !sfData) ? 0.6 : 1 }}
          >
            {isLinking ? 'Linking...' : 'Link'}
          </button>
        </div>
      </div>

      <div style={{ display: 'flex', padding: '0 15px', background: '#d1e3f8', borderBottom: '1px solid #4a90e2' }}>
        {['TAB 1', 'TAB 2', 'TAB 3', 'TAB 4', 'TAB 5', 'TAB 6'].map(tab => (
          <div key={tab} style={getTabStyle(tab)} onClick={() => setActiveTab(tab)}>{tab}</div>
        ))}
      </div>

      <div style={{ padding: '20px', background: '#fff' }}>
        {loading ? (
          <div style={{ display: 'flex', justifyContent: 'center', padding: '100px' }}>
            <Spinner size="large" />
          </div>
        ) : (
          <>
            {activeTab === 'TAB 1' && (
              <div>
                <h4 style={{ color: '#6B778C', marginBottom: '15px', fontSize: '13px', borderBottom: '1px solid #ccc' }}>Account Information</h4>
                <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '40px' }}>
                  <div>
                    <InfoRow label="Account Name" value={sfData?.['Account Name']} />
                    <InfoRow label="Account Number" value={sfData?.['Account Number']} />
                    <InfoRow label="Customer Type" value={sfData?.['Type']} />
                    <InfoRow label="Salesforce ID" value={sfData?.['Salesforce Account Id']} />
                  </div>
                  <div>
                    <InfoRow label="Email Address" value={sfData?.['Account Email']} />
                    <InfoRow label="Signup Type" value={sfData?.['Signup_Type__c']} />
                    <InfoRow label="Jira Issue Key" value={sfData?.['Jira Issue Key']} />
                  </div>
                </div>
              </div>
            )}

            {activeTab === 'TAB 2' && (
              <div style={{ padding: '10px' }}>
                <h4 style={{ color: '#6B778C', marginBottom: '15px', fontSize: '13px', borderBottom: '1px solid #ccc' }}>
                  Related Cases {sfData?.cases ? `(${sfData.cases.length})` : '(0)'}
                </h4>
                {sfData?.cases && sfData.cases.length > 0 ? (
                  <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '12px' }}>
                    <thead>
                      <tr style={{ textAlign: 'left', borderBottom: '2px solid #4a90e2', color: '#4a90e2' }}>
                        <th style={{ padding: '10px 5px' }}>Case Number</th>
                        <th style={{ padding: '10px 5px' }}>Subject</th>
                        <th style={{ padding: '10px 5px' }}>Status</th>
                      </tr>
                    </thead>
                    <tbody>
                      {sfData.cases.map((caseItem, index) => (
                        <tr key={index} style={{ borderBottom: '1px solid #f0f0f0' }}>
                          <td style={{ padding: '10px 5px', fontWeight: 'bold' }}>
                            <button
                              type="button"
                              onClick={() => openCaseDetail(caseItem)}
                              style={{
                                background: 'none',
                                border: 'none',
                                padding: 0,
                                color: '#0052CC',
                                fontWeight: 'bold',
                                fontSize: '12px',
                                cursor: 'pointer',
                                textDecoration: 'underline'
                              }}
                            >
                              {caseItem.caseNumber}
                            </button>
                          </td>
                          <td style={{ padding: '10px 5px' }}>{caseItem.subject}</td>
                          <td style={{ padding: '10px 5px' }}>
                            <span style={{
                              backgroundColor: caseItem.status === 'Closed' ? '#E3FCEF' : '#DEEBFF',
                              color: caseItem.status === 'Closed' ? '#006644' : '#0747A6',
                              padding: '2px 8px', borderRadius: '3px', fontWeight: 'bold', fontSize: '10px'
                            }}>
                              {caseItem.status?.toUpperCase()}
                            </span>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                ) : (
                  <div style={{ textAlign: 'center', padding: '50px', color: '#6B778C' }}>
                    <p>No related cases found for this account.</p>
                  </div>
                )}
              </div>
            )}

            {['TAB 3', 'TAB 4', 'TAB 5', 'TAB 6'].includes(activeTab) && (
              <div style={{ textAlign: 'center', padding: '100px', color: '#6B778C', fontStyle: 'italic' }}>
                This section is currently blank.
              </div>
            )}
          </>
        )}
      </div>

      {caseModalOpen && (
        <div
          onClick={closeCaseModal}
          style={{
            position: 'fixed',
            inset: 0,
            background: 'rgba(9, 30, 66, 0.55)',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            zIndex: 1000,
            padding: '16px'
          }}
        >
          <div
            onClick={(e) => e.stopPropagation()}
            style={{
              background: '#fff',
              borderRadius: '8px',
              width: '100%',
              maxWidth: '560px',
              maxHeight: '85vh',
              overflow: 'auto',
              boxShadow: '0 8px 24px rgba(9, 30, 66, 0.25)',
              border: '1px solid #4a90e2'
            }}
          >
            <div style={{
              display: 'flex',
              justifyContent: 'space-between',
              alignItems: 'center',
              padding: '14px 18px',
              background: 'linear-gradient(to right, #4a90e2, #7ebffc)',
              color: '#fff'
            }}>
              <div>
                <div style={{ fontSize: '11px', opacity: 0.9 }}>Case detail</div>
                <div style={{ fontSize: '15px', fontWeight: 'bold' }}>{selectedCaseNumber || '—'}</div>
              </div>
              <button
                type="button"
                onClick={closeCaseModal}
                style={{
                  background: 'rgba(255,255,255,0.2)',
                  border: 'none',
                  color: '#fff',
                  width: '32px',
                  height: '32px',
                  borderRadius: '4px',
                  cursor: 'pointer',
                  fontSize: '18px',
                  lineHeight: '32px'
                }}
              >
                ×
              </button>
            </div>

            <div style={{ padding: '16px 18px 20px' }}>
              {caseLoading && (
                <div style={{ display: 'flex', justifyContent: 'center', padding: '12px 0 20px' }}>
                  <Spinner size="medium" />
                </div>
              )}

              {caseWarning && (
                <div style={{
                  background: '#FFFAE6',
                  border: '1px solid #FFC400',
                  color: '#172B4D',
                  padding: '10px 12px',
                  borderRadius: '4px',
                  fontSize: '12px',
                  marginBottom: '12px'
                }}>
                  {caseWarning}
                </div>
              )}

              <SectionTitle>Case</SectionTitle>
              {caseDetailRows.length > 0 ? (
                caseDetailRows.map(([label, value]) => (
                  <InfoRow key={`case-${label}`} label={label} value={value} />
                ))
              ) : (
                <div style={{ color: '#6B778C', fontSize: '12px' }}>No case fields.</div>
              )}

              <SectionTitle>Installation</SectionTitle>
              {installationRows.length > 0 ? (
                installationRows.map(([label, value]) => (
                  <InfoRow key={`install-${label}`} label={label} value={value} />
                ))
              ) : (
                <InfoRow label="Installation details" value="Not returned by n8n for this case yet" />
              )}

              <SectionTitle>Delivery</SectionTitle>
              {deliveryRows.length > 0 ? (
                deliveryRows.map(([label, value]) => (
                  <InfoRow key={`delivery-${label}`} label={label} value={value} />
                ))
              ) : (
                <InfoRow label="Delivery details" value="Not returned by n8n for this case yet" />
              )}
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

export default App;
